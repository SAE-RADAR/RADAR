[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/navigation/room_choice/room_menu.gd" id="1_menu"]

[sub_resource type="Theme" id="Theme_menu"]
default_font_size = 44

[sub_resource type="StyleBoxFlat" id="StyleBox_panel"]
bg_color = Color(0.06, 0.07, 0.1, 0.95)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

[node name="RoomMenu" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_menu")
theme_override_styles/panel = SubResource("StyleBox_panel")
script = ExtResource("1_menu")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "Choisissez une salle"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 40
